# ==============================================================================
# CHOVIA — Monorepo Root .gitignore
# Stack: pnpm, Turborepo, Next.js, React Native/Expo, Fastify, Prisma 7, PostgreSQL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Package Manager & Dependencies
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
jspm_packages/

# ------------------------------------------------------------------------------
# 2. Turborepo Cache & Logs
# ------------------------------------------------------------------------------
.turbo/

# ------------------------------------------------------------------------------
# 3. Web Applications — Next.js (Admin, Marketing, Restaurant)
# ------------------------------------------------------------------------------
.next/
out/
apps/web/*/.next/
apps/web/*/out/
apps/web/*/build/

# ------------------------------------------------------------------------------
# 4. Mobile Applications — Expo & React Native (Customer, Rider)
# ------------------------------------------------------------------------------
.expo/
.expo-shared/
web-build/
apps/mobile/*/.expo/
apps/mobile/*/.expo-shared/
apps/mobile/*/web-build/

# Mobile Signing Certificates & Keystores (Local Credentials)
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision

# ------------------------------------------------------------------------------
# 5. Backend & Build Artifacts (Fastify, TypeScript, Packages)
# ------------------------------------------------------------------------------
dist/
build/
backend/dist/
backend/build/
backend/src/generated/prisma/
packages/*/dist/
packages/*/build/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 6. Database & Local Runtimes
# ------------------------------------------------------------------------------
# Exclude SQLite or local dump files (PostgreSQL is authoritative via Neon)
*.db
*.db-journal
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 7. Environment Variables & Secrets (MANDATORY AGENTS.md RULE)
# ------------------------------------------------------------------------------
.env
.env*
!.env.example
!.env.template

# ------------------------------------------------------------------------------
# 8. Testing & Coverage
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# ------------------------------------------------------------------------------
# 9. Logs & Runtime Ephemera
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 10. Operating System & Editor Artifacts
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# IDEs & Editors
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
