# CHOVIA Customer Mobile - Expo public configuration
# Copy to .env in this directory. Restart Expo after changing this value.
# Physical phone: use your development computer's LAN IPv4 address.
# Android emulator: http://10.0.2.2:4000/api/v1
# iOS simulator / Web: http://localhost:4000/api/v1
# Physical phone example: http://192.168.1.100:4000/api/v1
# CHOVIA Customer Mobile App — Environment Configuration
# Copy to .env and configure for your target runtime.
# Required on physical devices (Android/iOS): replace <YOUR_LAN_IP> with your computer LAN IP.
# Android emulator automatically defaults to http://10.0.2.2:4000/api/v1 if omitted.
# iOS simulator & Web automatically default to http://localhost:4000/api/v1 if omitted.
EXPO_PUBLIC_API_URL=http://<YOUR_LAN_IP>:4000/api/v1
