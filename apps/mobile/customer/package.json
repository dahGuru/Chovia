{
  "name": "@chovia/mobile-customer",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "build": "expo export --platform all",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --no-cache",
    "clean": "node -e \"const fs=require('fs'); ['.expo','dist','.turbo'].forEach(p=>{if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true})})\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.108.2",
    "axios": "^1.21.1",
    "expo": "58.0.26",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "58.0.32",
    "expo-status-bar": "~58.0.5",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "3.4.17",
    "zod": "^3.25.76",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "^19.2.0"
  }
}
