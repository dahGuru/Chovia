{
  "expo": {
    "name": "CHOVIA Rider",
    "slug": "chovia-rider",
    "scheme": "chovia-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CHOVIA Rider uses your location to verify your operating zone and dispatch nearby delivery orders while you are online."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
