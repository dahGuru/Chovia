# ==============================================================================
# CHOVIA Backend API — Environment Configuration Template
# Copy this file to .env for local development. Never commit .env to source control.
# ==============================================================================

# Node Environment
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
FRONTEND_URL="http://localhost:3000"

# PostgreSQL 18 + Neon Database URL (with PostGIS enabled)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chovia?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/chovia?schema=public"

# Authentication & Cryptographic Secrets (minimum 32 characters each, distinct in production)
JWT_ACCESS_SECRET="chovia_dev_jwt_access_secret_must_be_overridden_in_prod_32c"
JWT_REFRESH_SECRET="chovia_dev_jwt_refresh_secret_must_be_overridden_in_prod_32c"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=30

# HMAC-SHA256 Secret for OTP Generation & Verification
OTP_HMAC_SECRET="chovia_dev_otp_hmac_secret_must_be_overridden_in_prod_32c"
OTP_EXPIRES_IN_MINUTES=15

# Redis Cache & BullMQ Background Queues (redis:// or rediss:// for TLS; port 1-65535; db 0-15; no localhost in staging/production)
REDIS_URL="redis://localhost:6379"

# CORS Configuration (Comma-separated list of allowed origins; wildcard * forbidden in production/staging)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Integration Mock Mode (Set to true in development to run without external API credentials; strictly forbidden in staging and production)
MOCK_INTEGRATIONS=false

# Paystack Payment Gateway (sk_live_* required in production; sk_test_* allowed in staging/development)
PAYSTACK_SECRET_KEY="sk_test_placeholder"
PAYSTACK_PUBLIC_KEY="pk_test_placeholder"
PAYSTACK_WEBHOOK_SECRET="webhook_secret_placeholder"

# Cloudinary Media Management (required in staging and production; inspected via magic bytes)
CLOUDINARY_CLOUD_NAME="chovia-cloud"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="cloudinary_secret_placeholder"

# Resend Transactional Email Delivery (required in staging and production)
RESEND_API_KEY="re_placeholder_123456789"
EMAIL_FROM="CHOVIA <no-reply@chovia.app>"

# Sentry Error Monitoring & Observability (required in staging and production; PII & tokens scrubbed)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Google Maps Platform (Routes API & Geocoding; mock & haversine fallback forbidden in staging/production)
GOOGLE_MAPS_API_KEY="AIzaSyPlaceholderKey"
GOOGLE_MAPS_USE_ROUTES_API=true

# Expo Push Notifications (Optional in local development; recommended in staging/production for authenticated push dispatch)
EXPO_ACCESS_TOKEN=""
