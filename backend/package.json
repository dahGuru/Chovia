{
  "name": "@chovia/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests --no-cache",
    "clean": "node -e \"const fs=require('fs'); ['dist','.turbo'].forEach(p=>{if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true})})\""
  },
  "dependencies": {
    "@chovia/types": "workspace:*",
    "@chovia/validation": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^9.0.4",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@fastify/type-provider-zod": "^1.0.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "^11.16.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.45.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-raw-body": "^6.0.3",
    "ioredis": "^5.6.1",
    "pg": "^8.23.1",
    "resend": "^6.39.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.20.6"
  }
}
