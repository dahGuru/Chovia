{
  "name": "chovia",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.6.0 <13"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "db:validate": "prisma validate --schema database/prisma/schema.prisma",
    "db:format": "prisma format --schema database/prisma/schema.prisma",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "5.1.1",
    "dotenv": "^18.0.10",
    "eslint": "10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "turbo": "^2.11.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "type": "module"
}
